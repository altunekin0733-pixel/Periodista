# =============================================================
# Periodista — ortam değişkenleri
# Bu dosyayı `.env` olarak kopyalayıp değerleri doldurun.
# Vercel'de aynı anahtarları Project Settings → Environment Variables'a girin.
# =============================================================

# --- Veritabanı (zorunlu) ---------------------------------------------------
# Neon, Supabase veya Vercel Postgres'ten alınan bağlantı adresi.
# Havuzlanmış (pooled) adres uygulama için kullanılır.
DATABASE_URL="postgresql://kullanici:sifre@host/veritabani?sslmode=require"

# Migration ve seed komutları havuzsuz (direct) adresi tercih eder.
# Neon/Supabase panelinde "direct connection" olarak geçer.
# Sağlayıcınız ayrım yapmıyorsa DATABASE_URL ile aynı değeri verin.
DIRECT_URL="postgresql://kullanici:sifre@host/veritabani?sslmode=require"

# --- Yönetici hesabı (zorunlu) ----------------------------------------------
ADMIN_USERNAME="editor"

# `npm run admin:hash -- "sifreniz"` komutuyla üretin. Ham şifre saklanmaz.
ADMIN_PASSWORD_HASH=""

# Oturum çerezini imzalar. En az 32 karakter olmalı.
# Üretmek için: openssl rand -base64 32
AUTH_SECRET=""

# --- Görsel deposu (haber görselleri için zorunlu) --------------------------
# Vercel panelinde Storage → Blob oluşturup projeye bağlayınca otomatik gelir.
BLOB_READ_WRITE_TOKEN=""

# --- Site adresi (isteğe bağlı) ---------------------------------------------
# Kendi alan adınızı bağladığınızda ayarlayın. Boşsa Vercel'in verdiği adres
# kullanılır, yerelde http://localhost:3000 varsayılır.
# Kanonik adresler, sitemap, RSS ve OpenGraph bu değeri kullanır.
NEXT_PUBLIC_SITE_URL=""
