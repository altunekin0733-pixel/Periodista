# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — .env.example depoda kalır, gerçek değerler kalmaz
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# tasarım arşivi ve Claude Design yükleme önbelleği (tasarım dosyalarınca kullanılmıyor)
/design-reference/*.zip
/design-reference/canvas/uploads/

# statik dışa aktarım çıktısı
/out/
