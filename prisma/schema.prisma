// Periodista — veri modeli
// Üretim: Vercel + hosted Postgres (Neon / Supabase / Vercel Postgres)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Bağlantı adresleri prisma.config.ts içinde tanımlıdır (Prisma 7 kuralı).
datasource db {
  provider = "postgresql"
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  icon        String    @default("newspaper")
  description String    @default("")
  /// Menüdeki ve ana sayfadaki sıralama
  position    Int       @default(0)
  /// Spor kategorisi ayrı logo kullanır — tasarımdaki davranış
  logoVariant String    @default("default")
  articles    Article[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([position])
}

model Article {
  id         String        @id @default(cuid())
  slug       String        @unique
  title      String
  dek        String        @default("")
  /// Sanitize edilmiş HTML (editörden gelir)
  body       String
  /// Aramada kullanılan düz metin karşılığı
  plainText  String        @default("")
  coverImage String?
  coverAlt   String        @default("")
  authorName String
  categoryId String
  category   Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  tags       Tag[]         @relation("ArticleTags")
  status     ArticleStatus @default(DRAFT)
  featured   Boolean       @default(false)
  breaking   Boolean       @default(false)
  publishedAt DateTime?
  readMins   Int           @default(3)
  viewCount  Int           @default(0)
  seoTitle       String?
  seoDescription String?
  comments   Comment[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([status, publishedAt(sort: Desc)])
  @@index([categoryId, status, publishedAt(sort: Desc)])
  @@index([featured, status, publishedAt(sort: Desc)])
  @@index([breaking, status, publishedAt(sort: Desc)])
}

model Tag {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  articles  Article[] @relation("ArticleTags")
  createdAt DateTime  @default(now())
}

model Comment {
  id          String        @id @default(cuid())
  articleId   String
  article     Article       @relation(fields: [articleId], references: [id], onDelete: Cascade)
  authorName  String
  authorEmail String?
  body        String
  status      CommentStatus @default(PENDING)
  createdAt   DateTime      @default(now())

  @@index([articleId, status, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc)])
}

/// Sosyal medya bağlantıları, site başlığı gibi tekil ayarlar
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
